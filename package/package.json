{
  "name": "@farming-labs/graft",
  "version": "0.2.0",
  "description": "Graft and Graft Mono, a sans and a mono for interfaces and code, variable from 100 to 900.",
  "license": "OFL-1.1",
  "homepage": "https://graft.farming-labs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/graft-font.git",
    "directory": "package"
  },
  "keywords": [
    "font",
    "variable-font",
    "graft",
    "monospace",
    "next-font",
    "farmjs"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "font",
    "farm",
    "fonts",
    "*.css",
    "OFL.txt"
  ],
  "exports": {
    "./font/sans": {
      "types": "./font/sans.d.ts",
      "default": "./font/sans.js"
    },
    "./font/mono": {
      "types": "./font/mono.d.ts",
      "default": "./font/mono.js"
    },
    "./farm/sans": {
      "types": "./farm/sans.d.ts",
      "default": "./farm/sans.js"
    },
    "./farm/mono": {
      "types": "./farm/mono.d.ts",
      "default": "./farm/mono.js"
    },
    "./sans.css": "./sans.css",
    "./mono.css": "./mono.css",
    "./graft.css": "./graft.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "node scripts/copy-fonts.mjs"
  },
  "peerDependencies": {
    "@farm.js/core": ">=0.1.85",
    "next": ">=13.2.0"
  },
  "peerDependenciesMeta": {
    "@farm.js/core": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
